  "process_steps": [
    {
      "id": 11,
      "main_process_id": 1,
      "step_code": "1.1",
      "activity_type_id": 1,
      "activity_description": "New customer first contact (initial inquiry intake).",
      "tat_min": null,
      "tat_max": null,
      "tat_unit": "immediate",
      "tat_raw": "Immediate",
      "remarks": "WhatsApp for first contact. No standard inquiry template exists.",
      "sequence_order": 1
    },
    {
      "id": 12,
      "main_process_id": 1,
      "step_code": "1.2",
      "activity_type_id": 2,
      "activity_description": "Sales receives inquiry and performs background verification.",
      "tat_min": 1,
      "tat_max": 2,
      "tat_unit": "days",
      "tat_raw": "1–2 days",
      "remarks": "No formal verification SOP. Process is ad hoc and varies by salesperson. KYC form sent to new customer and must be returned before quotation proceeds.",
      "sequence_order": 2
    },
    {
      "id": 13,
      "main_process_id": 1,
      "step_code": "1.3",
      "activity_type_id": 3,
      "activity_description": "KYC form sent to and completed by new customer.",
      "tat_min": 1,
      "tat_max": 3,
      "tat_unit": "days",
      "tat_raw": "1–3 days (customer-dependent)",
      "remarks": "Customer delay is common. No tracking system for outstanding KYC forms. Finance approval required before any booking is released for new customers.",
      "sequence_order": 3
    },
    {
      "id": 14,
      "main_process_id": 1,
      "step_code": "1.4",
      "activity_type_id": 1,
      "activity_description": "Existing customer contacts Sales or CS directly for rate / booking.",
      "tat_min": null,
      "tat_max": null,
      "tat_unit": "same_day",
      "tat_raw": "Immediate / same day",
      "remarks": "~35–40 inquiries per day across the team with no centralised tracking. No CRM in use. Dropped or unconverted inquiries are invisible — no conversion rate data available. Existing customers bypass formal onboarding and communicate directly with CS.",
      "sequence_order": 4
    },
    {
      "id": 21,
      "main_process_id": 2,
      "step_code": "2.1",
      "activity_type_id": 4,
      "activity_description": "CS checks AMS for contracted or monthly rates.",
      "tat_min": null,
      "tat_max": null,
      "tat_unit": "minutes",
      "tat_raw": "Minutes",
      "remarks": "AMS holds contracted rates (fixed 1–6 months) and monthly rates (15-day validity). Spot rates are absent from AMS. Not all liner rates are always updated — gaps exist when liners have not yet issued new rate sheets. AMS is not linked to Gensoft.",
      "sequence_order": 1
    },
    {
      "id": 22,
      "main_process_id": 2,
      "step_code": "2.2",
      "activity_type_id": 5,
      "activity_description": "If rate unavailable in AMS, CS requests rate from Procurement.",
      "tat_min": null,
      "tat_max": null,
      "tat_unit": "hours",
      "tat_raw": "Hours (same day)",
      "remarks": "Informal channel — WhatsApp group used for all rate requests. Process is undocumented with no SLA. Risk of delays when procurement team is unavailable. Spot rates are never stored centrally after retrieval.",
      "sequence_order": 2
    },
    {
      "id": 23,
      "main_process_id": 2,
      "step_code": "2.3",
      "activity_type_id": 5,
      "activity_description": "Procurement retrieves rate from shipping line and updates AMS.",
      "tat_min": null,
      "tat_max": null,
      "tat_unit": "hours",
      "tat_raw": "Minutes to hours (liner-dependent)",
      "remarks": "Each liner sends rate sheets on different schedules (daily, 15-day, monthly). ~12 shipping lines total; 80% of volume through 4–5 main carriers (US: ~70% via MSC). Rates not always current in AMS at point of inquiry. Spot rates never stored centrally.",
      "sequence_order": 3
    },
    {
      "id": 24,
      "main_process_id": 2,
      "step_code": "2.4",
      "activity_type_id": 6,
      "activity_description": "Sales determines markup and quotes customer.",
      "tat_min": null,
      "tat_max": null,
      "tat_unit": "same_day",
      "tat_raw": "Same day",
      "remarks": "No standardised markup guidelines. Markup is 100% salesperson judgment. Very low or zero-margin deals accepted without approval. Quotation options (Option 1, 2, 3) may be given. Gensoft has quotation module but it is not used. Subject to space availability for spot rates.",
      "sequence_order": 4
    }
  ],
